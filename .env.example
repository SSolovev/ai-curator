# Только несекретные параметры. Не помещайте сюда Jira PAT.
CURATOR_PORT=8080
LLAMA_THREADS=8
# CPU fallback = 0. Значение >0 требует отдельного GPU-enabled llama.cpp image/backend; см. docs/CONFIGURATION.md.
LLAMA_GPU_LAYERS=0
# Каталог должен содержать только публичный корпоративный CA bundle.
CURATOR_CA_DIR=./certs
# Единственный runtime процесса: llama_cpp, ollama или external. После изменения повторите scripts/start.*.
CURATOR_LLM_RUNTIME=llama_cpp
# Native Ollama доступна приложению через специальное локальное имя Docker Desktop.
CURATOR_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Основной локальный тег: ai-curator-gemma4-12b; более лёгкая альтернатива: ai-curator-qwen3-8b.
CURATOR_OLLAMA_MODEL=ai-curator-gemma4-12b
# Внешний runtime имеет отдельный обязательный opt-in. Ключ храните только в
# secrets/external_llm_api_key, а не в этом файле.
CURATOR_EXTERNAL_LLM_ENABLED=false
CURATOR_EXTERNAL_LLM_BASE_URL=https://api.openai.com/v1
CURATOR_EXTERNAL_LLM_MODEL=gpt-4.1-mini
CURATOR_EXTERNAL_LLM_API_KEY_FILE=/secrets/external_llm_api_key
# Сырой контекст сначала фильтруется отдельной локальной моделью Ollama,
# затем словарём secrets/pii_dictionary.txt. При сбое запрос наружу запрещён.
CURATOR_PII_FILTER_BASE_URL=http://host.docker.internal:11434
CURATOR_PII_FILTER_MODEL=ai-curator-pii-gemma3-4b
CURATOR_PII_FILTER_DICTIONARY_FILE=/secrets/pii_dictionary.txt
CURATOR_PII_FILTER_TIMEOUT_SECONDS=300
CURATOR_PII_FILTER_BATCH_ITEMS=20
CURATOR_PII_FILTER_BATCH_CHARS=12000
CURATOR_LLM_TIMEOUT_SECONDS=1500
CURATOR_LLM_TEMPERATURE=0.2
CURATOR_LLM_MAX_TOKENS=6000
CURATOR_LLM_REASONING_EFFORT=none
# Двухэтапный анализ: партии без лимита комментариев, до 20000 символов.
CURATOR_LLM_COMMENT_BATCH_CHARS=20000
# На CPU повторная полная генерация отключена.
CURATOR_LLM_REPAIR_ENABLED=false
# Для локального runtime лог содержит полный контекст сотрудника. Для external —
# обезличенный внешний запрос и ответ. Сырой запрос PII-модели никогда не логируется.
CURATOR_LLM_LOG_REQUEST_RESPONSE=false
# Включайте только временно: полный запрос и ответ Jira содержат персональные данные.
# Заголовок Authorization и PAT намеренно не логируются.
CURATOR_JIRA_LOG_REQUEST_RESPONSE=false
# Включайте временно: не-JSON ответ Jira может содержать персональные данные.
CURATOR_JIRA_LOG_INVALID_RESPONSE_BODY=false
# Включайте временно для сопоставления id и названий полей Jira.
CURATOR_JIRA_LOG_FIELD_CATALOG=false
# Включайте временно для сопоставления полей со значениями выбранной Employee-задачи.
CURATOR_JIRA_LOG_EMPLOYEE_ISSUE=false
CURATOR_JIRA_LOG_RESPONSE_MAX_CHARS=4000
# Один запрос к Jira: не более 50 последних комментариев Employee-задачи.
CURATOR_JIRA_MAX_COMMENTS=50
