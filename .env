# Только несекретные параметры. Не помещайте сюда Jira PAT.
CURATOR_PORT=8080
LLAMA_THREADS=8
# CPU fallback = 0. Значение >0 требует отдельного GPU-enabled llama.cpp image/backend; см. docs/CONFIGURATION.md.
LLAMA_GPU_LAYERS=0
# Каталог должен содержать только публичный корпоративный CA bundle.
CURATOR_CA_DIR=./certs
CURATOR_LLM_RUNTIME=ollama
CURATOR_LLM_TIMEOUT_SECONDS=1500
CURATOR_LLM_TEMPERATURE=0.2
CURATOR_LLM_MAX_TOKENS=6000
CURATOR_LLM_REASONING_EFFORT=none
CURATOR_LLM_COMMENT_BATCH_SIZE=10
CURATOR_LLM_COMMENT_BATCH_CHARS=24000
# На CPU повторная полная генерация отключена.
CURATOR_LLM_REPAIR_ENABLED=false
# Включайте только временно: лог содержит полный контекст сотрудника и ответ модели.
CURATOR_LLM_LOG_REQUEST_RESPONSE=true
# Включайте только временно: полный URL, query-параметры и тело ответа Jira без маскирования.
# Заголовок Authorization и PAT не логируются.
CURATOR_JIRA_LOG_REQUEST_RESPONSE=true
# Включайте только временно для диагностики настоящей Jira.
CURATOR_JIRA_LOG_INVALID_RESPONSE_BODY=true
# Включайте только временно для сопоставления полей настоящей Jira.
CURATOR_JIRA_LOG_FIELD_CATALOG=true
CURATOR_JIRA_LOG_EMPLOYEE_ISSUE=true
CURATOR_JIRA_LOG_RESPONSE_MAX_CHARS=4000
CURATOR_JIRA_MAX_COMMENTS=50


CURATOR_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Основная модель — Gemma 4 12B Q4_K_M с контекстом 16K.
CURATOR_OLLAMA_MODEL=ai-curator-gemma4-12b
# Более лёгкая альтернатива:
# CURATOR_OLLAMA_MODEL=ai-curator-qwen3-8b
